# ==============================================================================
# GRAND LUXE HOTEL & SUITES — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env in your root directory: cp .env.example .env
# 2. Fill in your credentials from Supabase, Resend, and your chosen JWT secret.
# 3. For Vercel deployment, configure these identical variables under:
#    Vercel Project Dashboard -> Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain from: https://supabase.com/dashboard/project/<your-project-id>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key (used if browser queries Supabase directly)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Secret Service Role Key (SERVER ONLY - NEVER EXPOSE TO CLIENT OR BROWSER)
# Bypasses RLS to allow backend serverless functions to query and insert reservations
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. RESEND EMAIL SERVICE CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Verified sender email in Resend.
# For testing without a custom domain, you can use: Grand Luxe Hotel <onboarding@resend.dev>
RESEND_FROM_EMAIL=Grand Luxe Hotel <onboarding@resend.dev>

# Hotel Owner / General Manager Email Address
# All new booking notifications will be delivered to this address
HOTEL_NOTIFICATION_EMAIL=owner@grandluxehotel.com

# Optional: Send automated confirmation receipt email to guest (true/false)
SEND_CUSTOMER_CONFIRMATION=true

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Cryptographically strong secret key used for signing customer/admin JWT session tokens
JWT_SECRET=super_secret_jwt_passphrase_change_this_in_production_2026

# ------------------------------------------------------------------------------
# 4. HOTEL POLICIES & BILLING (OPTIONAL OVERRIDES)
# ------------------------------------------------------------------------------
# Configurable hotel tax / GST rate percentage (default: 10%)
HOTEL_TAX_PERCENTAGE=10

# Local backend port (default: 3001)
PORT=3001
